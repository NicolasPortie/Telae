# Exemplo: ajuste User, Group e os caminhos para a sua instalação.
[Unit]
Description=Telae signaling server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=telae
Group=telae
WorkingDirectory=/home/telae/apps/telae/server/current
Environment=ASPNETCORE_ENVIRONMENT=Production
# Escute só no loopback e publique por um túnel ou proxy reverso com TLS.
Environment=ASPNETCORE_URLS=http://127.0.0.1:5015
Environment=Profiles__Path=/home/telae/apps/telae/data/profiles.json
Environment=Updates__Path=/var/lib/telae-updates/windows
EnvironmentFile=-/home/telae/apps/telae/telae-server.env
ExecStart=/usr/bin/dotnet /home/telae/apps/telae/server/current/Telae.Server.dll
Restart=always
RestartSec=3
TimeoutStopSec=15
KillSignal=SIGINT
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/telae/apps/telae/data

[Install]
WantedBy=multi-user.target

