[Unit]
Description=Telae signaling server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=usuario
Group=usuario
WorkingDirectory=/home/usuario/apps/telae/server/current
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=ASPNETCORE_URLS=http://0.0.0.0:5015
Environment=Profiles__Path=/home/usuario/apps/telae/data/profiles.json
Environment=Updates__Path=/var/lib/telae-updates/windows
EnvironmentFile=-/home/usuario/apps/telae/telae-server.env
ExecStart=/usr/bin/dotnet /home/usuario/apps/telae/server/current/Telae.Server.dll
Restart=always
RestartSec=3
TimeoutStopSec=15
KillSignal=SIGINT
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/usuario/apps/telae/data

[Install]
WantedBy=multi-user.target

