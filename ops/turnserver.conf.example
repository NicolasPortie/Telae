# TEMPLATE: copy to a protected path and replace placeholders before starting coturn.
# See docs/RELEASE_VALIDATION.md. Never commit the populated file.
listening-port=3478
tls-listening-port=5349
min-port=49160
max-port=49260
fingerprint
use-auth-secret
static-auth-secret=REPLACE_WITH_A_RANDOM_SECRET_SHARED_WITH_TELAE_SERVER
realm=turn.example.com
server-name=turn.example.com
cert=/etc/letsencrypt/live/turn.example.com/fullchain.pem
pkey=/etc/letsencrypt/live/turn.example.com/privkey.pem
no-cli
no-loopback-peers
no-multicast-peers
# Prevent relay into private infrastructure; adapt only to explicit deployment needs.
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.168.0.0-192.168.255.255
denied-peer-ip=169.254.0.0-169.254.255.255
denied-peer-ip=::1
denied-peer-ip=fc00::-fdff:ffff:ffff:ffff:ffff:ffff:ffff:ffff
denied-peer-ip=fe80::-febf:ffff:ffff:ffff:ffff:ffff:ffff:ffff
# Bind to deployment interfaces. For NAT, configure external-ip=PUBLIC/PRIVATE
# and forward the relay port range one-to-one; a reverse HTTP proxy is insufficient.
