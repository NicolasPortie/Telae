# Copie para .env e preencha. Nunca versione o .env.

# Banco de dados
POSTGRES_PASSWORD=troque-por-uma-senha-forte

# Assinatura dos tokens de acesso (mínimo de 32 caracteres): openssl rand -base64 48
TELAE_JWT_KEY=

# E-mail transacional por SMTP (verificação de conta e recuperação de senha).
# Deixe SMTP_HOST vazio para apenas registrar os códigos no log (desenvolvimento).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Remetente, com domínio que você controla (configure SPF, DKIM e DMARC): Telae <nao-responda@seudominio.com>
SMTP_FROM=
