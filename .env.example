# Copie para .env e preencha. Nunca versione o .env.

# Banco de dados
POSTGRES_PASSWORD=troque-por-uma-senha-forte

# Assinatura dos tokens de acesso (mínimo de 32 caracteres): openssl rand -base64 48
TELAE_JWT_KEY=

# Acesso. O cadastro vem FECHADO: só os e-mails listados abaixo conseguem criar conta.
# Separe vários e-mails por vírgula. Para abrir o cadastro a qualquer pessoa, use TELAE_REGISTRATION_OPEN=true.
TELAE_ALLOWED_EMAILS=
TELAE_REGISTRATION_OPEN=false

# E-mail transacional por SMTP (verificação de conta e recuperação de senha).
# Configure SMTP para receber os códigos; eles não são gravados nos logs.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Remetente, com domínio que você controla (configure SPF, DKIM e DMARC): Telae <nao-responda@seudominio.com>
SMTP_FROM=
