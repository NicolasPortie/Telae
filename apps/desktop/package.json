{
  "name": "desktop",
  "private": true,
  "version": "0.1.17",
  "description": "Telae desktop app for low-latency screen sharing with synchronized system audio.",
  "author": "Telae",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc -b && electron-vite build",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "test": "vitest run",
    "test:e2e": "playwright test -c playwright.config.ts",
    "preview": "electron-vite preview",
    "build:audio-bridge": "dotnet publish ../audio-bridge/Telae.AudioBridge.csproj -c Release -r win-x64 --self-contained true -o ./build/audio-bridge",
    "dist": "npm run build && npm run build:audio-bridge && electron-builder --win --publish never"
  },
  "dependencies": {
    "@microsoft/signalr": "^10.0.11",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.48.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.6.1",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.2"
  }
}
